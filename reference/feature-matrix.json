{
  "schema": "oracle-to-postgres-migration-advisor.feature-matrix/v1",
  "description": "How each PostgreSQL target carries each Oracle feature. native, workaround, redesign, unsupported, unknown. Oracle targets carry every feature and are not listed.",
  "states": {
    "native": "The target carries it with the same behaviour.",
    "workaround": "Carried through an extension or a pattern, with caveats a person checks.",
    "redesign": "No equivalent. The application or the data model changes.",
    "unsupported": "The target cannot carry it at all, even with a redesign.",
    "unknown": "The vendor documentation does not say. Never read as native."
  },
  "targets": [
    "pg_flex",
    "pg_elastic",
    "horizondb",
    "pg_vm",
    "pg_aks"
  ],
  "features": [
    {
      "featureId": "RAC_WRITE_SCALE",
      "label": "RAC used to scale writes across nodes",
      "scanConstructs": [],
      "targets": {
        "pg_flex": {
          "state": "workaround",
          "note": "One writer. Scale up inside the ceilings; reads scale out through replicas",
          "sources": []
        },
        "pg_elastic": {
          "state": "redesign",
          "note": "Writes scale by sharding on a distribution key, which changes the data model",
          "sources": [
            "ms-fs-elastic-limits"
          ]
        },
        "horizondb": {
          "state": "workaround",
          "note": "One writer, up to 192 vCores per replica; shared-storage read replicas",
          "sources": [
            "ms-horizondb-compute"
          ]
        },
        "pg_vm": {
          "state": "workaround",
          "note": "One writer. Scale up the VM",
          "sources": []
        },
        "pg_aks": {
          "state": "workaround",
          "note": "One writer. Scale up the node",
          "sources": []
        }
      }
    },
    {
      "featureId": "RAC_HA_ONLY",
      "label": "RAC used only for availability",
      "scanConstructs": [],
      "targets": {
        "pg_flex": {
          "state": "native",
          "note": "Zone-redundant HA, 99.99% SLA, typically 60 to 120 seconds to fail over",
          "sources": [
            "ms-fs-reliability"
          ]
        },
        "pg_elastic": {
          "state": "native",
          "note": "Per-node HA",
          "sources": [
            "ms-fs-elastic-limits"
          ]
        },
        "horizondb": {
          "state": "native",
          "note": "Zone-redundant replicas. No published SLA",
          "sources": [
            "ms-horizondb-overview"
          ]
        },
        "pg_vm": {
          "state": "workaround",
          "note": "The operator builds and tests HA",
          "sources": []
        },
        "pg_aks": {
          "state": "native",
          "note": "CloudNativePG runs one primary and two replicas across zones",
          "sources": [
            "ms-aks-cnpg"
          ]
        }
      }
    },
