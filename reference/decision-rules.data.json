  "flexibleServer": {
    "supportedMajors": {
      "recommended": [
        16,
        17,
        18
      ],
      "acceptable": [
        15
      ],
      "avoid": [
        14
      ],
      "paidExtendedSupport": [
        11,
        12,
        13
      ]
    },
    "standardSupportEnds": {
      "14": "2026-12-11",
      "15": "2027-11-11",
      "16": "2028-11-09",
      "17": "2029-11-08",
      "18": "2030-11-14"
    },
    "storageTiB": {
      "premiumSsd": 32,
      "premiumSsdV2": 64
    },
    "plannedFillRatio": 0.8,
    "maxIops": {
      "premiumSsd": 20000,
      "premiumSsdV2": 80000
