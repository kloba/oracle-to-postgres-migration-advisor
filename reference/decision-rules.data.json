  "converter": {
    "name": "AI-assisted schema conversion in the PostgreSQL extension for VS Code (ms-ossdata.vscode-pgsql)",
    "schemaConversionStatus": "GA since 1.23.0 (2026-05-26)",
    "applicationConversionStatus": "Preview",
    "oracleVersionsListed": [
      "ORA_12C",
      "ORA_18C",
      "ORA_19C",
      "ORA_21C"
    ],
    "oracleVersionsNotListed": [
      "ORA_11G_OR_OLDER",
      "ORA_23AI_26AI"
    ],
    "movesRowData": false,
    "requires": {
      "foundryModel": "gpt-5.2",
      "foundryTokensPerMinute": 1000000,
      "githubCopilot": "Pro+, Business or Enterprise",
      "scratchDatabase": "Azure Database for PostgreSQL flexible server, PostgreSQL 15 or later; HorizonDB is not accepted"
    },
    "notConverted": [
      "Java in the database",
      "external C libraries",
      "wrapped PL/SQL",
      "bitmap and global-partitioned and domain indexes",
      "materialized view logs",
      "external tables",
      "Advanced Queuing",
      "clusters",
      "DIRECTORY objects",
      "database links",
      "application contexts",
      "VPD / DBMS_RLS",
      "DBMS_SCHEDULER and DBMS_JOB objects",
      "users, roles and privileges",
      "system-event triggers"
    ],
    "sources": [
      "ms-oracle-schema-conversion",
      "ms-oracle-schema-limitations",
      "ms-oracle-schema-tutorial",
      "ms-vscode-pgsql-changelog"
    ]
